# Alshival stack ports
ADMIN_PORT=3000
ADMIN_HOST=127.0.0.1
BACKEND_HOST=127.0.0.1
BACKEND_PORT=4000
MCP_HOST=127.0.0.1
MCP_PORT=4100
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000

# Optional explicit service URLs. Defaults are derived from host/port above.
# BACKEND_URL=http://127.0.0.1:4000
# MCP_URL=http://127.0.0.1:4100

# Optional agent limits
# AGENT_MAX_TOOL_ROUNDS=24
# AGENT_MAX_INPUT_TOKENS=24000

# Optional knowledge sync tuning
# KNOWLEDGE_SYNC_INTERVAL_MS=3600000
# KNOWLEDGE_SYNC_INITIAL_DELAY_MS=30000

# Platform/tool credentials
# DISCORD_BOT_TOKEN=
# TENOR_API_KEY=
